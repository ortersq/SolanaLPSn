# GEMINI_API_KEY: Optional, enables AI pool risk audit in the dashboard
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where the app is hosted
APP_URL="http://localhost:3000"

# HELIUS_RPC_URL: Solana Mainnet RPC endpoint (configured in server .env)
HELIUS_RPC_URL="https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY"

# PRIVATE_KEY: Trading wallet Base58 private key (server backend .env only, never enter in frontend)
PRIVATE_KEY=""

# RECIPIENT_ADDRESS: Solana public key for automated profit sweep (server backend .env only)
RECIPIENT_ADDRESS=""

# WATCH_WALLET_ADDRESS: Optional read-only wallet address displayed masked on overview telemetry
WATCH_WALLET_ADDRESS=""

# DRY_RUN: Keep true for safe simulation & risk checks; set false to execute live on-chain transactions
DRY_RUN="true"

# Strategy & risk defaults (200U active-yield or balanced-steady)
RISK_PROFILE="balanced-steady"
CAPITAL_USDT="200"
MIN_TVL_USD="2000000"
MIN_APR="45"
RANGE_WIDTH_PCT="10"
HARVEST_MIN_USD="2.5"
STOP_LOSS_PCT="6"
SLIPPAGE_BPS="50"
